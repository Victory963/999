# ---- 999 agent-computer configuration ----
# Copy to .env and edit. Everything has a safe default; nothing here is required
# to boot (without an Anthropic credential the agent runs a harmless stub brain).

# --- The brain (Anthropic API) ---
# The SDK also accepts an `ant auth login` profile or ANTHROPIC_AUTH_TOKEN.
# Leave unset to run the offline stub brain (useful for a UI/plumbing smoke test).
ANTHROPIC_API_KEY=
# Model id. Default is the current flagship; override to a cheaper one if you like.
ANTHROPIC_MODEL=claude-opus-5-5
# Hard cap on agent iterations per task (stops runaway loops).
AGENT_MAX_STEPS=24

# --- HTTP server ---
PORT=8080
HOST=127.0.0.1
# If set, every /api/* request must send `Authorization: Bearer <token>`
# (EventSource may pass it as ?token=). Strongly recommended if HOST != 127.0.0.1.
API_TOKEN=
# Comma-separated Origins allowed for mutating API calls (CSRF guard).
# Defaults to the server's own origin; override if the UI is served elsewhere.
# ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Max tasks running at once; extra tasks queue as "planned".
MAX_CONCURRENT_TASKS=3
# Per-client-IP /api request cap per minute.
RATE_LIMIT_PER_MIN=120

# --- Workspace (the agent's jailed filesystem) ---
# All file + shell operations are confined to this directory.
WORKSPACE_DIR=./workspace
# STATE_DIR holds the task store + browser profile (defaults under the workspace).
# STATE_DIR=./workspace/.state
# Byte ceiling for the workspace; fs_write refuses writes that would exceed it (0 = unlimited).
WORKSPACE_QUOTA_BYTES=52428800

# --- Goals & tracking (scheduled page/price/content monitors) ---
GOAL_DEFAULT_INTERVAL_SEC=300
GOAL_MIN_INTERVAL_SEC=30

# --- Sandboxed shell ---
# Comma-separated ALLOWLIST of bare executable names the agent may run.
# NOTE: the default list deliberately excludes interpreters (node/python/sh) and
# network tools (curl/wget). A command-name allowlist is NOT a security boundary
# on its own — run the whole process inside a container/VM for real isolation.
# SHELL_ALLOW=ls,cat,head,tail,wc,echo,pwd,grep,find,sort,uniq,date,diff,tr,cut,basename,dirname,stat,file
SHELL_TIMEOUT_MS=15000
SHELL_MAX_OUTPUT_BYTES=100000

# --- Browser (Playwright/Chromium, optional) ---
# Run `pnpm browser:install` once to download Chromium before using browser tools.
BROWSER_HEADLESS=true
# BROWSER_USER_DATA_DIR=./workspace/.state/browser-profile
BROWSER_NAV_TIMEOUT_MS=30000
# SSRF guard: when false (default), navigation to private/loopback IPs is blocked.
BROWSER_ALLOW_PRIVATE_NETWORK=false
